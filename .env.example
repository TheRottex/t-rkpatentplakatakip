PORT=4400
PUBLIC_BASE_URL=http://localhost:4400
JWT_SECRET=degistir-bu-anahtari

# Vortex sunucusu — hesap açma / giriş bu adrese bağlanır.
# Veri dosyaları aynı makinede DATA_DIR altında tutulur.
VORTEX_SERVER_URL=https://vortex.rottexforge.com
VORTEX_AUTH_REGISTER=/api/auth/register
VORTEX_AUTH_LOGIN=/api/auth/login
VORTEX_AUTH_ME=/api/me

DATA_DIR=./data
SEED_CSV=./data/plates.csv

# İsteğe bağlı: yerel doğrulama kodu (Vortex yanıt vermezse)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BlokTakip <noreply@localhost>

{
  "name": "tpplaka",
  "version": "1.0.0",
  "private": true,
  "description": "TPPlaka: yetkili kullanıcılar için site ve blok araç plaka takibi.",
  "engines": {
    "node": ">=18.20 <19"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node server/index.js\" \"vite --host\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "start:win": "set NODE_ENV=production&& node server/index.js",
    "test": "node --test test/*.test.js",
    "bootstrap-admin": "node server/bootstrap-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  }
}
